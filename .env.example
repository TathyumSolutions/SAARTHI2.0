# Copy this file to .env and fill in real values before running the app
# or `docker-compose up`. All of these have safe local-dev defaults except
# the LLM API keys, so a fresh .env can start empty and grow as needed.

# Flask
FLASK_ENV=production
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Database (host/port/credentials only - the app derives its 3 logical
# databases (core/resources/workspace) from this one base URL, see
# config/config.py). Matches the db service in docker-compose.yml.
DATABASE_URL=postgresql://saarthi:password@db:5432/saarthi

# Redis (matches the redis service in docker-compose.yml)
REDIS_URL=redis://redis:6379/0

# Comma-separated list of trusted origins allowed to make cross-origin
# requests, e.g. http://localhost:3000,https://app.example.com. Leave
# unset to deny all cross-origin requests.
ALLOWED_ORIGINS=

# Comma-separated list of emails allowed to provision new companies via
# /api/platform/companies.
SUPERADMIN_EMAILS=

# LLM API keys (optional - only needed for the providers you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=

# AWS (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Space-separated list of Ollama models to pull/warm on `docker-compose up`.
# Defaults to just llama2:7b (see ollama-init in docker-compose.yml) so a
# fresh startup doesn't pull several multi-GB models.
OLLAMA_MODELS=llama2:7b
